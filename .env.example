# Wings configuration. ./scripts/setup.sh copies this to .env, generates the
# secrets marked [generated], and sets mode 600. Everything else is optional.
#
# .env holds the key that decrypts every stored credential. Keep an offline
# copy (password manager or encrypted USB) and never commit it.
# Values must not contain spaces or inline comments.

# ============================================================================
# Required. [generated] by ./scripts/setup.sh; never change after first start
# ============================================================================

# Fernet key that encrypts provider API keys, mail, calendar and MCP
# credentials at rest. Stored here, not in the data volume, so a stolen
# backup or volume copy cannot be decrypted. Changing it makes every stored
# credential unreadable. To move an existing in-volume key here, run
# ./scripts/adopt-key.sh --yes.
ODYSSEUS_APP_KEY=

# First admin account, created on the very first start only. Changing these
# later has no effect; change the password in Settings instead. The password
# must be at least 8 characters, or no admin is created and the setup page
# stays open to whoever reaches it first.
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=

# SearXNG session secret. [generated]
SEARXNG_SECRET=

# ============================================================================
# Access
# ============================================================================

# Host address and port for the web UI. 127.0.0.1 = this machine only.
# 0.0.0.0 = your whole LAN (then also add the LAN URL to ALLOWED_ORIGINS).
# For remote access prefer --domain (HTTPS below) or Tailscale.
APP_BIND=127.0.0.1
APP_PORT=7011

# Browser origins allowed to call the API (comma separated, no spaces).
# Must include the exact URL you type in the browser.
ALLOWED_ORIGINS=http://localhost:7011,http://127.0.0.1:7011

# Empty = Secure cookies follow the request scheme. Set true behind HTTPS.
SECURE_COOKIES=

# Timezone for reminders, scheduled tasks and calendar maths, e.g.
# Europe/London, America/New_York, Asia/Tokyo.
TZ=Etc/UTC

# Optional services, comma separated: ollama, caldav, https.
# setup.sh flags (--with-ollama, --with-caldav, --domain) maintain this.
COMPOSE_PROFILES=

# Extra compose files, colon separated. setup.sh --ollama-gpu nvidia sets
# docker-compose.yml:compose/ollama-nvidia.yml
# COMPOSE_FILE=

# Compose project name; prefixes container and volume names.
COMPOSE_PROJECT_NAME=wings

# ============================================================================
# HTTPS (profile https). setup.sh --domain NAME --acme-email EMAIL fills these
# ============================================================================
# WINGS_DOMAIN=ai.example.com
# WINGS_ACME_EMAIL=you@example.com
# With --domain, setup.sh also sets ALLOWED_ORIGINS, SECURE_COOKIES=true,
# OAUTH_REDIRECT_BASE_URL and FORWARDED_ALLOW_IPS (trust only the proxy).
# FORWARDED_ALLOW_IPS=172.30.57.250
# OAUTH_REDIRECT_BASE_URL=https://ai.example.com

# Internal Docker network. Change only if 172.30.57.0/24 clashes with a
# network you already use. The proxy keeps a fixed address outside the
# dynamic range so FORWARDED_ALLOW_IPS can trust exactly that one container.
# WINGS_SUBNET=172.30.57.0/24
# WINGS_IP_RANGE=172.30.57.0/25
# WINGS_PROXY_IP=172.30.57.250

# ============================================================================
# Email safety (Wings patch 0004)
# ============================================================================

# 1 (default) = no email leaves without a person clicking Send in the web app.
# Agents write drafts; API tokens, plugins and away auto-replies cannot send.
# 0 = upstream behaviour (agents may send if the in-app setting allows).
WINGS_FORCE_EMAIL_CONFIRM=1

# Your own addresses, comma separated. Automated mail (task results,
# reminders) may go to these and only these. Empty = no automated mail.
WINGS_EMAIL_SELF_ADDRESSES=

# true = allow mail servers on private addresses: Proton Mail Bridge,
# DavMail (for Outlook/Exchange), or a LAN mail server.
EMAIL_ALLOW_PRIVATE_IPS=

# Gmail / Google Workspace "Connect with Google" OAuth (optional; a Gmail
# app password works without any of this). See docs/email-and-calendar.md.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7011/api/email/oauth/google/callback

# ============================================================================
# Calendar
# ============================================================================

# 1 = allow CalDAV servers on private addresses. Needed for the bundled
# Radicale (profile caldav) or a CalDAV server on your LAN.
ODYSSEUS_ALLOW_PRIVATE_CALDAV=0

# Bundled Radicale (profile caldav). setup.sh --with-caldav fills these.
# RADICALE_USER=wings
# RADICALE_PASSWORD=
# Host address/port for phones and desktop calendar apps. Loopback by
# default; use a LAN or Tailscale IP, or reach it at https://<domain>/dav/.
# RADICALE_BIND=127.0.0.1
# RADICALE_PORT=5232

# ============================================================================
# Models. Add providers in the web app: Settings > Services
# ============================================================================

# Local Ollama. Bundled container: http://ollama:11434/v1 (setup.sh
# --with-ollama). Ollama on the Docker host (best on macOS, which gives
# containers no GPU): http://host.docker.internal:11434/v1
# OLLAMA_BASE_URL=
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_CONTEXT_LENGTH=16384

# LM Studio on the Docker host.
# LM_STUDIO_URL=http://host.docker.internal:1234

# Hostnames scanned for local model servers (Settings > Services > scan).
# LLM_HOST=localhost
# LLM_HOSTS=

# Legacy OpenAI key read by some upstream code paths. Prefer adding OpenAI
# in Settings, where the key is stored encrypted.
# OPENAI_API_KEY=

# HuggingFace token for gated model downloads in Cookbook.
# HF_TOKEN=

# Embeddings for file search and memory. Empty = built-in FastEmbed model
# (downloaded once, about 50 MB). Any OpenAI-compatible /v1/embeddings works.
# EMBEDDING_URL=http://ollama:11434/v1/embeddings
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# Web search. SearXNG (bundled, free, private) works with no key.
# Keys here stay out of the database (Settings > Search stores them in
# plaintext settings.json, so prefer these variables).
# ============================================================================
# DATA_BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_PSE_CX=

# ============================================================================
# Notifications (ntfy). Loopback by default; for phone push set NTFY_BIND
# to a LAN or Tailscale IP and NTFY_BASE_URL to the matching URL.
# ============================================================================
# NTFY_BIND=127.0.0.1
# NTFY_PORT=8091
# NTFY_BASE_URL=http://localhost:8091

# ============================================================================
# Behaviour and limits
# ============================================================================

# Taint-based approval gate for agent actions after untrusted web or mail
# content enters a run. Keep 1.
ODYSSEUS_TOOL_APPROVAL_GATE=1

# false (Wings default) = scheduled agent tasks run on time even while a
# browser tab is open. true = upstream behaviour: defer them while you are
# active, so they do not compete with you for a single local GPU.
BACKGROUND_TASK_FOREGROUND_GATE=false

# 1 (Wings default) = do not download an unpinned @playwright/mcp from npm at
# every start. Browser automation does not work in this upstream build anyway.
ODYSSEUS_BROWSER_MCP_REQUIRE_CACHE=1

# Upload size caps in bytes.
ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=52428800
ODYSSEUS_PERSONAL_UPLOAD_MAX_BYTES=52428800
ODYSSEUS_EMAIL_COMPOSE_UPLOAD_MAX_BYTES=26214400

# Housekeeping interval and in-process background workers.
# CLEANUP_INTERVAL_HOURS=24
# ODYSSEUS_INPROCESS_POLLERS=1
# ODYSSEUS_INPROCESS_TASKS=1

# Owner of files inside the data volumes.
# PUID=1000
# PGID=1000

# ============================================================================
# Upgrades and development
# ============================================================================

# Base image the Wings overlay is built on. Pinned by digest in
# docker-compose.yml; change only together with upstream.lock and a rebase
# of patches/ (scripts/dev/rebase-overlay.sh). The build refuses a base whose
# patched files differ from what the overlay expects.
# ODYSSEUS_BASE_IMAGE=ghcr.io/odysseus-dev/odysseus:1.0.3-9d0d372@sha256:5117c5e07e5976095ce213e601277ff372e0387a67de34c5fd59a3de723e6113
# WINGS_IMAGE_TAG=1.0.3-9d0d372-w1

# SearXNG listen address inside its container (IPv4 avoids a crash loop on
# hosts with IPv6 disabled).
# SEARXNG_LISTEN=0.0.0.0
