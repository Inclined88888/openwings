        "$value": "#1B281C",
        "$type": "color",
        "$description": "oklch(.260 .028 145)  L* 15.6  moss ink"
      },
      "ochre-500": {
        "$value": "#7A4C13",
        "$type": "color",
        "$description": "oklch(.460 .092 67)   L* 36.7"
