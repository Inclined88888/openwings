  "motion": {
    "easing": {
      "out": {
        "$value": [
          0.23,
          1.0,
          0.32,
          1.0
        ],
        "$type": "cubicBezier",
        "$description": "entrances, exits, UI response"
      },
      "in-out": {
        "$value": [
          0.77,
          0.0,
          0.175,
          1.0
        ],
        "$type": "cubicBezier",
        "$description": "movement on screen"
      },
      "drawer": {
        "$value": [
          0.32,
          0.72,
          0.0,
          1.0
        ],
        "$type": "cubicBezier",
        "$description": "sheets, the phone sidebar"
      },
      "draw": {
        "$value": [
          0.645,
          0.045,
          0.355,
          1.0
        ],
        "$type": "cubicBezier",
        "$description": "rules and SVG lines drawing in"
      },
      "hover": {
        "$value": "ease",
        "$type": "string",
        "$description": "hover and colour"
      },
      "linear": {
        "$value": "linear",
        "$type": "string",
        "$description": "real progress"
      },
      "spring": {
        "$value": "linear(0, 0.0356, 0.1197, 0.2271, 0.3413, 0.4521, 0.5535, 0.6428, 0.7191, 0.7826, 0.8345, 0.876, 0.9088, 0.9341, 0.9534, 0.9679, 0.9786, 0.9863, 0.9918, 0.9956, 0.9981, 0.9997, 1.0007, 1.0012, 1)",
        "$type": "string",
        "$description": "underdamped spring (bounce 0.1, response 0.36s, sampled over 400ms) as CSS linear(), for the one lead title of a page load; fallback cubic-bezier(0.3, 1.08, 0.5, 1) where linear() is unsupported",
        "$extensions": {
          "openwings": {
            "fallback": "cubic-bezier(0.3, 1.08, 0.5, 1)"
          }
        }
      }
    },
