# Radicale CalDAV/CardDAV server (profile: caldav).
# Accounts: ./config/radicale/users (bcrypt htpasswd), managed by
# ./scripts/setup.sh --with-caldav. Calendars live in the radicale-data volume.

[server]
hosts = 0.0.0.0:5232
max_connections = 20
# 50 MB, enough for large .ics imports
max_content_length = 50000000
timeout = 30

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = bcrypt
# Slow down password guessing
delay = 2

[rights]
# Each user sees only their own calendars
type = owner_only

[storage]
filesystem_folder = /data/collections

[web]
type = internal

[logging]
level = warning
mask_passwords = True

[headers]
Content-Security-Policy = default-src 'self'; object-src 'none'
