diff --git a/src/tool_capabilities.py b/src/tool_capabilities.py
index f0ba4b3..790ed07 100644
--- a/src/tool_capabilities.py
+++ b/src/tool_capabilities.py
@@ -538,6 +538,24 @@ def capabilities_for_action(tool_name: Any, content: Any) -> ToolCapabilities:
                 known=base.known,
             )
 
+    # Wings: a browser action that carries a workspace file (an upload into a
+    # page's file field) sends local data to a website. Classify it as an
+    # external side effect so the approval gate shows the person the exact
+    # upload before it happens (browsing always arms that gate).
+    if tool_name == "private_browser":
+        payload = content
+        if isinstance(payload, str):
+            try:
+                payload = json.loads(payload) if payload.strip().startswith("{") else {}
+            except (TypeError, ValueError):
+                payload = {}
+        if isinstance(payload, Mapping) and str(payload.get("path") or "").strip() and \
+                str(payload.get("action") or "").strip().lower() in {"fill", "press", "click", "upload"}:
+            return ToolCapabilities(
+                frozenset(base.effects | {ToolEffect.READ_WORKSPACE, ToolEffect.EXTERNAL_SIDE_EFFECT}),
+                base.result_integrity, known=base.known,
+            )
+
     if tool_name == "extract_text":
         payload = content
         if isinstance(payload, str):
