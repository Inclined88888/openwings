+def _drop_retracted_rounds(answer_events: list[dict], answer: str,
+                           metrics_events: list[dict]) -> tuple[list[dict], str]:
+    """Release only the rounds the agent loop kept.
+
+    When the loop's supervisor rejects a round (a false "I can't" while the
+    tool was offered, a promise without the tool call, a clarification the
+    person already answered) it asks the model again and retracts that round,
+    but the round's deltas were already buffered here. Releasing them glued
+    several answers into one message ("No. I cannot ...No, I still cannot
+    ..."). The loop reports the retracted round numbers (and a replacement
+    text when it rewrote a round) in its terminal metrics; drop exactly those
+    rounds' deltas. No text matching: the cleaned round text can differ from
+    the raw stream (tool fences, trimmed promises) on any provider.
+    Kept rounds that would run together get a blank line between them.
+    """
+    report = next((e.get('data') for e in reversed(metrics_events)
+                   if isinstance(e.get('data'), dict)
+                   and isinstance(e['data'].get('retracted_rounds'), list)), None)
+    if not report or not report['retracted_rounds']:
+        return answer_events, answer
+    drop = {r for r in report['retracted_rounds'] if isinstance(r, int)}
+    replaced = {}
+    for key, value in (report.get('replaced_rounds') or {}).items():
+        try:
+            replaced[int(key)] = str(value or '')
+        except (TypeError, ValueError):
+            continue
+
+    def is_answer(event) -> bool:
+        return event.get('thinking') is not True and 'delta' in event
+
+    if not any(is_answer(e) and e.get('round') in drop for e in answer_events):
+        return answer_events, answer
+    out: list[dict] = []
+    last_round = None
+    text = ''
+    emitted_replacement = set()
+
+    def add(event, rnd):
+        nonlocal last_round, text
+        delta = str(event.get('delta') or '')
+        if not delta:
+            out.append(event)
+            return
+        if last_round is not None and rnd != last_round and text and not text[-1].isspace():
+            out.append({'delta': '\n\n', 'round': rnd})
+            text += '\n\n'
+        last_round = rnd
+        text += delta
+        out.append(event)
+
+    for event in answer_events:
+        rnd = event.get('round')
+        if not is_answer(event):
+            out.append(event)
+            continue
+        if rnd in drop:
+            if replaced.get(rnd, '').strip() and rnd not in emitted_replacement:
+                emitted_replacement.add(rnd)
+                add({'delta': replaced[rnd], 'round': rnd}, rnd)
+            continue
+        add(event, rnd)
+    return out, text
+
