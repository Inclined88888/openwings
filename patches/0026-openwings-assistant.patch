diff --git a/tests/test_openwings_assistant_identity.py b/tests/test_openwings_assistant_identity.py
new file mode 100644
index 0000000..e4478a9
--- /dev/null
+++ b/tests/test_openwings_assistant_identity.py
@@ -0,0 +1,123 @@
+"""OpenWings patch 0026: the assistant knows it is OpenWings, in every mode.
+
+Owner report: on a Grok model the assistant said "I'm Grok, an AI built by
+xAI", denied having memory or tools, and answered "No." to a request about
+files on the host Mac. The model never received any OpenWings identity: Chat
+mode sent only the prompt safety policy, Agent mode said "You are an AI
+assistant". These tests pin the fix: one trusted identity message comes
+first in the preface for Chat and Agent turns, names the model, lists what
+the install can do and how to reach what it cannot.
+Runs inside the image (needs the wings package); no network.
+"""
+from types import SimpleNamespace
+
+import pytest
+
+wings_identity = pytest.importorskip("wings.assistant_identity")
+
+from src.chat_processor import ChatProcessor  # noqa: E402
+
+
+@pytest.fixture(autouse=True)
+def _admin_with_native_tools(monkeypatch):
+    # "sam" stands for an admin here; member accounts are covered below and
+    # in tests/unit/test_wings_assistant_identity.py.
+    monkeypatch.setattr(wings_identity, "blocked_tools", lambda owner: frozenset())
+    monkeypatch.setattr(wings_identity, "tools_off_reason", lambda *a, **k: "")
+    wings_identity.clear_cache()
+
+
+class _Memory:
+    def load(self, owner=None):
+        return []
+
+    def increment_uses(self, ids):
+        pass
+
+
+class _Docs:
+    rag_manager = None
+
+
+def _preface(agent_mode, **kw):
+    proc = ChatProcessor(memory_manager=_Memory(), personal_docs_manager=_Docs())
+    sess = SimpleNamespace(model="x-ai/grok-4.1-fast", endpoint_url="https://openrouter.ai/api/v1")
+    preface, _, _ = proc.build_context_preface(
+        message="who are you", session=sess, use_rag=False, use_memory=False,
+        agent_mode=agent_mode, owner="sam", **kw)
+    return preface
+
+
+@pytest.mark.parametrize("agent_mode", [False, True])
+def test_identity_message_comes_first_and_names_the_model(agent_mode):
+    preface = _preface(agent_mode)
+    first = preface[0]
+    assert first["role"] == "system"
+    text = first["content"]
+    assert text.startswith("## Who you are\nYou are OpenWings")
+    assert "Grok (grok-4.1-fast) from xAI, reached through OpenRouter" in text
+    assert "Import from Hermes" in text
+    assert 'Never answer with only "No"' in text
+    assert "Odysseus" not in text
+    if agent_mode:
+        assert "Chat mode" not in text
+    else:
+        assert "switching to Agent mode" in text
+    # Identical across turns: the cached prefix survives.
+    assert _preface(agent_mode)[0] == first
+
+
+def test_persona_keeps_its_name_but_learns_what_openwings_can_do():
+    text = _preface(False, character_name="Ada")[0]["content"]
+    assert text.startswith("## Who you are\nYou are Ada, a character the person set up inside OpenWings")
+    assert "Memory: keep facts" in text
+
+
+def test_agent_prompts_no_longer_compete_with_the_identity():
+    import src.agent_loop as al
+
+    assert "You are an AI assistant" not in al._AGENT_PREAMBLE
+    for tools in ({"web_search"}, {"write_file", "inspect_media"}):
+        assert "You are an AI assistant" not in al._assemble_prompt(tools, compact=True)
+
+
+def test_grok_gets_native_tools_on_any_openai_compatible_host(monkeypatch):
+    import src.agent_loop as al
+
+    is_api_model, _, _ = al._agent_route_tool_mode("http://litellm.lan:4000/v1", "grok-4")
+    assert is_api_model is True
+
+
+def test_skills_index_in_the_preface_does_not_block_reading_own_memory():
+    """The preface's skill index is server-owned metadata, like "skills": with
+    only it present, reading the person's own memory needs no approval."""
+    from src.tool_capabilities import ToolRunSecurityContext
+
+    class _Skills:
+        def index_for(self, owner=None):
+            return [{"name": "trip-planner", "description": "Plan trips", "category": "travel"}]
+
+    proc = ChatProcessor(memory_manager=_Memory(), personal_docs_manager=_Docs(), skills_manager=_Skills())
+    preface, _, _ = proc.build_context_preface(
+        message="can you see my memory?", session=SimpleNamespace(model="grok-4", endpoint_url=""),
+        use_rag=False, use_memory=False, agent_mode=True, owner="sam")
+    assert any("trip-planner" in str(m.get("content")) for m in preface)
+    ctx = ToolRunSecurityContext()
+    ctx.observe_messages(preface)
+    assert ctx.decision_for("manage_memory", '{"action": "list"}').allowed
+
+
+def test_question_about_hermes_memory_is_not_a_sealed_openwings_memory_read():
+    from src.turn_contract import required_read_operation_for_request
+
+    assert required_read_operation_for_request("can you see my hermes memory?") is None
+    assert required_read_operation_for_request("show my Hermes sessions") is None
+    assert required_read_operation_for_request("list my memories") is not None
+
+
+def test_member_account_is_not_promised_admin_only_tools(monkeypatch):
+    from src.tool_security import NON_ADMIN_BLOCKED_TOOLS
+    monkeypatch.setattr(wings_identity, "blocked_tools", lambda owner: frozenset(NON_ADMIN_BLOCKED_TOOLS))
+    text = _preface(True)[0]["content"]
+    assert "Memory: keep facts" not in text and "Calendar:" not in text
+    assert "Ask an admin of this OpenWings to allow it for your account." in text
diff --git a/tests/test_supervisor_retracted_rounds.py b/tests/test_supervisor_retracted_rounds.py
new file mode 100644
index 0000000..8de2fd3
--- /dev/null
+++ b/tests/test_supervisor_retracted_rounds.py
@@ -0,0 +1,221 @@
+"""Regression: a round the agent supervisor rejects must not reach the chat.
+
+Owner report: a Grok model answered "can you see my hermes sessions and
+memory?" with one message holding three answers glued together:
+"No. I cannot see ... memory.No, I still cannot ...No, I still cannot ...".
+
+The loop rejected the first two answers (false "tool unavailable" claim while
+manage_memory was offered, or "I'll do X" without a tool call), nudged the
+model and asked again. Its own round_texts kept only the last answer, but the
+completion gate (src/agent_runtime/completion.py) buffered and then released
+every round's deltas, and the chat route saved what it streamed.
+
+The test drives the real decorated stream_agent_loop with a fake provider and
+replays the events through the route's _AgentRenderState, which is exactly
+what the browser renders and what chat_routes saves.
+"""
+import asyncio
+import json
+
+import pytest
+
+import src.agent_loop as al
+from src.tool_capabilities import ToolGateDecision
+
+
+# The owner's exact three answers (an outside app: since patch 0026 the loop
+# accepts this refusal instead of asking again, see the last test).
+HERMES_REFUSALS = [
+    "No. I cannot see or access your Hermes sessions or memory.",
+    "No, I still cannot see or access any Hermes sessions or external memory.",
+    "No, I still cannot see or access your Hermes sessions or memory.",
+]
+# The same shape about OpenWings' own memory: a false "unavailable" claim the
+# supervisor rejects and asks again.
+REFUSALS = [
+    "No. I cannot see or access your saved memory.",
+    "No, I still cannot see or access any saved memory.",
+    "No, I still cannot access your saved memory.",
+]
+PROMISES = [
+    "Let me check your Hermes memory files now.",
+    "I'll look in the Hermes folder next.",
+    "Let me open the Hermes sessions now.",
+]
+
+
+def _patch(monkeypatch, answers):
+    monkeypatch.setattr(al, "get_setting", lambda key, default=None: default, raising=False)
+    monkeypatch.setattr(al, "get_mcp_manager", lambda: None, raising=False)
+    import src.context_compactor as context_compactor
+    monkeypatch.setattr(context_compactor, "get_context_length", lambda *a, **k: 128_000)
+    monkeypatch.setattr(al, "tool_result_should_arm_gate", lambda *a, **k: False, raising=False)
+    monkeypatch.setattr(al.ToolRunSecurityContext, "decision_for",
+                        lambda self, *a, **k: ToolGateDecision(True), raising=False)
+    calls = {"n": 0}
+
+    async def fake_stream(_candidates, messages, **kwargs):
+        text = answers[min(calls["n"], len(answers) - 1)]
+        calls["n"] += 1
+        # Real providers stream word pieces with no trailing space at the end.
+        words = text.split(" ")
+        for i, word in enumerate(words):
+            yield f'data: {json.dumps({"delta": word + (" " if i < len(words) - 1 else "")})}\n\n'
+        yield "data: [DONE]\n\n"
+
+    monkeypatch.setattr(al, "stream_llm_with_fallback", fake_stream, raising=False)
+    return calls
+
+
+def _run(question, relevant_tools):
+    from routes.chat_routes import _AgentRenderState
+
+    async def go():
+        state = _AgentRenderState()
+        metrics = {}
+        async for chunk in al.stream_agent_loop(
+            "http://x/v1", "x-ai/grok-4",
+            [{"role": "user", "content": question}],
+            relevant_tools=set(relevant_tools), max_rounds=6, owner="test",
+        ):
+            if chunk.startswith("data: ") and "[DONE]" not in chunk:
+                event = state.consume(json.loads(chunk[6:]))
+                if event.get("type") == "metrics":
+                    metrics = event.get("data") or {}
+        return state.content, metrics
+
+    return asyncio.run(go())
+
+
+@pytest.mark.parametrize("answers,tools,question", [
+    (REFUSALS, {"manage_memory", "search_chats", "ask_user"},     # false "unavailable" nudges
+     "can you see my saved memory?"),
+    (PROMISES, {"ask_user", "bash", "python", "read_file"},       # intent without action nudges
+     "can you see my hermes sessions and memory?"),
+])
+def test_rejected_rounds_are_not_shown_or_saved(monkeypatch, answers, tools, question):
+    calls = _patch(monkeypatch, answers)
+    shown, metrics = _run(question, tools)
+    assert calls["n"] >= 2, "the supervisor should have asked the model again"
+    # What the person sees (and what chat_routes saves) is one answer.
+    assert sum(shown.count(a) for a in answers) == 1, shown
+    # Reload renders round_texts: it must agree with the live view.
+    assert [t for t in metrics.get("round_texts") or [] if t.strip()] == [shown.strip()]
+
+
+
+def test_true_refusal_about_another_app_is_not_asked_again(monkeypatch):
+    """Hermes' files live on the person's computer, outside OpenWings: the
+    refusal is true, so the loop must not push the model twice more (two
+    paid calls and, before the fix, three glued answers)."""
+    calls = _patch(monkeypatch, HERMES_REFUSALS)
+    shown, _ = _run("can you see my hermes sessions and memory?",
+                    {"manage_memory", "search_chats", "ask_user"})
+    assert calls["n"] == 1
+    # The bare refusal gets the reason and the way that works (review L3),
+    # once, in place of the streamed text.
+    assert shown.strip().startswith(HERMES_REFUSALS[0])
+    assert shown.count(HERMES_REFUSALS[0]) == 1
+    assert "Import from Hermes" in shown and "#import-hermes" in shown
+
+
+def _metrics(retracted=(), replaced=None, texts=()):
+    data = {"round_texts": list(texts)}
+    if retracted:
+        data["retracted_rounds"] = list(retracted)
+        data["replaced_rounds"] = dict(replaced or {})
+    return [{"type": "metrics", "data": data}]
+
+
+def test_gate_separates_two_kept_rounds_and_drops_the_retracted_one():
+    from src.agent_runtime.completion import _drop_retracted_rounds
+
+    events = [
+        {"delta": "Checking.", "round": 1},
+        {"delta": "Rejected draft.", "round": 2},
+        {"delta": "Here it is.", "round": 3},
+    ]
+    out, text = _drop_retracted_rounds(
+        events, "Checking.Rejected draft.Here it is.",
+        _metrics([2], texts=["Checking.", "Here it is."]))
+    assert text == "Checking.\n\nHere it is."
+    assert [e["delta"] for e in out] == ["Checking.", "\n\n", "Here it is."]
+    # Nothing retracted: unchanged, whatever the round texts say.
+    assert _drop_retracted_rounds(events, "x", [])[0] == events
+    assert _drop_retracted_rounds(events, "x", _metrics(texts=["other"]))[0] == events
+
+
+def test_gate_never_drops_a_kept_round_whose_text_differs_from_its_stream():
+    """Review H1: the loop keeps cleaned text (tool fences stripped, a trailing
+    "I should report this" promise trimmed), the stream holds the raw text.
+    Deciding by text match dropped the final answer; by round number it cannot."""
+    from src.agent_runtime.completion import _drop_retracted_rounds
+
+    events = [
+        {"delta": "Here is part one.", "round": 1},
+        {"delta": "Final answer. Let me know if you need more.", "round": 2},
+    ]
+    out, text = _drop_retracted_rounds(
+        events, "", _metrics(texts=["Here is part one.", "Final answer."]))
+    assert out == events
+
+    # Fenced tool mode: round 1 streamed prose plus a raw tool fence, round 2
+    # was a rejected draft, round 3 is the answer.
+    fenced = [
+        {"delta": "Let me look.\n```bash\nls ~\n```", "round": 1},
+        {"delta": "I can't run commands.", "round": 2},
+        {"delta": "Your home folder has 3 files.", "round": 3},
+    ]
+    out, text = _drop_retracted_rounds(
+        fenced, "", _metrics([2], texts=["Let me look.", "Your home folder has 3 files."]))
+    assert "I can't run commands." not in text
+    assert text.endswith("Your home folder has 3 files.")
+    assert text.startswith("Let me look.")
+
+
+def test_gate_shows_the_loop_replacement_for_a_rewritten_round():
+    """A trailing private promise trimmed after a tool result: the trimmed
+    text replaces that round's streamed deltas, once."""
+    from src.agent_runtime.completion import _drop_retracted_rounds
+
+    events = [
+        {"delta": "You have 2 meetings today.", "round": 2},
+        {"delta": " I should report this to the user.", "round": 2},
+    ]
+    out, text = _drop_retracted_rounds(
+        events, "", _metrics([2], {"2": "You have 2 meetings today."},
+                             texts=["You have 2 meetings today."]))
+    assert text == "You have 2 meetings today."
+    assert [e["delta"] for e in out] == ["You have 2 meetings today."]
+
+
+def test_round_text_log_records_retractions_by_round():
+    log = al._RoundTextLog()
+    log.current_round = 1
+    log.append("kept")
+    log.current_round = 2
+    log.append("draft")
+    log.pop()
+    log.current_round = 3
+    log.append("question?")
+    log[1] = ""                      # blanked later: retracted too
+    log.current_round = 4
+    log.retract_current()
+    log.append("trimmed")            # rewritten round: replacement text
+    assert list(log) == ["kept", "", "trimmed"]
+    assert log.retraction_report() == {
+        "retracted_rounds": [2, 3, 4],
+        "replaced_rounds": {"4": "trimmed"},
+    }
+    log[2] = "final with links"       # a later rewrite of a kept round is not a retraction
+    assert log.retraction_report()["retracted_rounds"] == [2, 3, 4]
+
+
+def test_gate_drops_identical_retries_the_loop_did_not_keep():
+    """A model asked again may repeat itself word for word; the loop kept one."""
+    from src.agent_runtime.completion import _drop_retracted_rounds
+
+    same = "Let me open the Hermes sessions now."
+    events = [{"delta": same, "round": r} for r in (1, 2, 3)]
+    out, text = _drop_retracted_rounds(events, same * 3, _metrics([1, 2], texts=[same]))
+    assert text == same and [e["round"] for e in out] == [3]
