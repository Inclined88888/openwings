+  try { body = await res.json(); } catch (_) { body = null; }
+  if (!res.ok) {
+    const detail = body && (typeof body.detail === 'string' ? body.detail : body.error);
+    throw new Error(detail || `Something went wrong (${res.status}).`);
+  }
+  return body || {};
