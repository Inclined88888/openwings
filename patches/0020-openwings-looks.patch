--- a/static/index.html
+++ b/static/index.html
@@ -26,6 +26,14 @@
   (function(){
     try {
       var t = JSON.parse(localStorage.getItem('odysseus-theme'));
+      // OpenWings: load its looks stylesheet and mark the chosen look before
+      // the first paint (the stylesheet only styles html[data-ow-skin=...]).
+      var owLink = document.createElement('link');
+      owLink.rel = 'stylesheet';
+      owLink.href = '/static/openwings/skins.css?v=1';
+      document.head.appendChild(owLink);
+      var owName = (t && t.name) || (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'ow-feather' : 'ow-feather-night');
+      document.documentElement.setAttribute('data-ow-skin', /^ow-/.test(owName) ? owName : '');
       if (t && t.colors) {
         var s = document.documentElement.style;
         var c = t.colors;
diff --git a/static/js/theme.js b/static/js/theme.js
index 1cb0ab2..871c8b0 100644
--- a/static/js/theme.js
+++ b/static/js/theme.js
@@ -522,7 +522,17 @@ export function getSaved() {
   return obj;
 }
 
+// OpenWings: themes named ow-* also change type, shapes and textures, not
+// only colors. Their stylesheet (static/openwings/skins.css) applies only
+// under html[data-ow-skin="<name>"].
+export function applyOpenWingsSkin(name) {
+  try {
+    document.documentElement.setAttribute('data-ow-skin', /^ow-/.test(String(name || '')) ? String(name) : '');
+  } catch (_) {}
+}
+
 export function save(name, colors, opts) {
+  applyOpenWingsSkin(name);
   const obj = { name, colors };
   if (opts) {
     if (normalizeFont(opts.font) !== DEFAULT_FONT) obj.font = normalizeFont(opts.font);
@@ -2328,3 +2338,6 @@ if (document.readyState === 'loading') {
 } else {
   _initWithSync();
 }
+
+// OpenWings: the look of the saved theme (or the default) from the start.
+try { applyOpenWingsSkin((getSaved() || {}).name || DEFAULT_THEME); } catch (_) {}
