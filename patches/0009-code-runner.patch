@@ -520,6 +520,13 @@ async def _run_owned_command(command, ctx: dict, *, tool: str, timeout: int, arg
                              readonly_extra: tuple = ()) -> dict:
     from src.tool_execution import agent_cwd, _truncate
 
+    # Wings: with the code runner container enabled, python and bash run there
+    # (no network, no secrets, only the agent workspace writable) instead of
+    # needing bubblewrap here, which Docker's default profile does not allow.
+    from wings import runner as _wings_runner
+    if _wings_runner.enabled() and tool in ("python", "bash"):
+        return await _wings_runner.run_owned(command, ctx, tool=tool, timeout=timeout, argv=argv)
