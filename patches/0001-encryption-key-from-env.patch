diff --git a/src/secret_storage.py b/src/secret_storage.py
index c4a08be..040fc12 100644
--- a/src/secret_storage.py
+++ b/src/secret_storage.py
@@ -11,6 +11,12 @@ backup, leaked container layer, sibling-tenant read). Does **not**
