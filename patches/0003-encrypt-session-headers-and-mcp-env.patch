+def _wings_migrate_encrypt_session_headers_and_mcp_env():
+    """Encrypt legacy plaintext sessions.headers and mcp_servers.env (Wings).
+
+    Idempotent: values already carrying the enc: prefix are skipped. Raw SQL,
+    so the column TypeDecorators are not applied twice."""
+    import json as _json
+    try:
+        from src.secret_storage import encrypt, is_encrypted
+    except Exception as e:
+        logger.warning(f"secret_storage import failed; skipping Wings header/env encryption: {e}")
+        return
+    try:
+        with engine.connect() as conn:
+            migrated = 0
+            for rid, raw in conn.execute(text("SELECT id, headers FROM sessions WHERE headers IS NOT NULL")).fetchall():
+                value = raw
+                # Legacy rows can be JSON encoded more than once; unwrap
+                # until we reach the object (or an already-encrypted string).
+                for _ in range(4):
+                    if not isinstance(value, str) or is_encrypted(value):
+                        break
+                    try:
+                        value = _json.loads(value)
+                    except ValueError:
+                        break
+                if not value or (isinstance(value, str) and is_encrypted(value)):
+                    continue
+                if isinstance(value, (dict, list)):
+                    conn.execute(
+                        text("UPDATE sessions SET headers = :h WHERE id = :id"),
+                        {"h": _json.dumps(encrypt(_json.dumps(value))), "id": rid},
+                    )
+                    migrated += 1
+            for rid, raw in conn.execute(text("SELECT id, env FROM mcp_servers WHERE env IS NOT NULL")).fetchall():
+                if raw and raw.strip() not in ("", "{}") and not is_encrypted(raw):
+                    conn.execute(text("UPDATE mcp_servers SET env = :e WHERE id = :id"), {"e": encrypt(raw), "id": rid})
+                    migrated += 1
+            if migrated:
+                conn.commit()
+                logger.info(f"Wings: encrypted {migrated} plaintext session header / MCP env value(s)")
+    except Exception as e:
+        logger.warning(f"Wings header/env encryption migration skipped: {e}")
+
+
