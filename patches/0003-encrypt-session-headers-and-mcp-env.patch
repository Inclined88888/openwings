--- a/core/database.py
+++ b/core/database.py
@@ -174,6 +174,38 @@ class EncryptedText(TypeDecorator):
         return decrypt(value)
 
 
+class EncryptedJSON(TypeDecorator):
+    """JSON column whose non-empty values are encrypted at rest (Wings).
+
+    The ciphertext is stored as a JSON *string* ("enc:..."), so the column
+    stays valid JSON on SQLite and Postgres alike. Legacy plaintext objects
+    are returned unchanged and get encrypted on their next write (plus a
+    startup migration). Empty values stay plain: there is nothing to hide.
+    """
+    impl = JSON
+    cache_ok = True
+
+    def process_bind_param(self, value, dialect):
+        if value is None or value == {} or value == []:
+            return value
+        import json as _json
+        from src.secret_storage import encrypt
+        return encrypt(_json.dumps(value))
+
+    def process_result_value(self, value, dialect):
+        if isinstance(value, str) and value.startswith("enc:"):
+            import json as _json
+            from src.secret_storage import decrypt
+            plain = decrypt(value)
+            if not plain:
+                return {}
+            try:
+                return _json.loads(plain)
+            except ValueError:
+                return {}
+        return value
+
+
