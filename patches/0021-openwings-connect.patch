+// The welcome card is placed by the current look (centred, or anchored above
+// the message box). Keep it between the top bar and the message box by
+// letting the panel scroll inside instead of the card running off screen.
+function fitWelcome() {
+  const ws = document.getElementById('welcome-screen');
+  const setup = document.getElementById('welcome-setup');
+  if (!ws || !setup || !ws.classList.contains('ow-has-setup') || ws.classList.contains('hidden')) return;
+  setup.style.maxHeight = 'none';
+  const bar = document.querySelector('.chat-input-bar');
+  const topBar = document.querySelector('.chat-top-bar');
+  for (let i = 0; i < 4; i++) {
+    const r = ws.getBoundingClientRect();
+    const limitTop = (topBar ? topBar.getBoundingClientRect().bottom : 0) + 6;
+    const barTop = bar ? bar.getBoundingClientRect().top : window.innerHeight;
+    const limitBottom = (barTop > r.top + 40 ? barTop : window.innerHeight) - 6;
+    const over = Math.max(0, limitTop - r.top) + Math.max(0, r.bottom - limitBottom);
+    if (over <= 1) break;
+    const cur = setup.getBoundingClientRect().height;
+    setup.style.maxHeight = Math.max(150, Math.floor(cur - over)) + 'px';
+  }
+}
+let _fitQueued = false;
+function refit() {
+  if (_fitQueued) return;
+  _fitQueued = true;
+  requestAnimationFrame(() => { _fitQueued = false; fitWelcome(); });
+}
