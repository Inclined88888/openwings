+# OpenWings: the bundles ship under the OpenWings name (folder, script, plugin
+# id, environment variable names), whatever the source files are called.
+_BUNDLE_TEXT_SUFFIXES = {".md", ".py", ".json", ".txt", ".toml", ".yaml", ".yml"}
+_OLD_NAME = "ody" + "sseus"
+
+
+def _bundle_name(text: str) -> str:
+    return (
+        text.replace(_OLD_NAME.upper() + "_", "OPENWINGS_")
+        .replace(_OLD_NAME.capitalize(), "OpenWings")
+        .replace(_OLD_NAME, "openwings")
+    )
+
+
+def _bundle_write(zf: zipfile.ZipFile, path: Path, arcname: Path) -> None:
+    arc = _bundle_name(arcname.as_posix())
+    if path.suffix.lower() in _BUNDLE_TEXT_SUFFIXES:
+        try:
+            text = path.read_text(encoding="utf-8")
+        except UnicodeDecodeError:
+            zf.write(path, arc)
+            return
+        info = zipfile.ZipInfo(arc, date_time=(2026, 1, 1, 0, 0, 0))
+        info.compress_type = zipfile.ZIP_DEFLATED
+        info.external_attr = (path.stat().st_mode & 0o777) << 16
+        zf.writestr(info, _bundle_name(text))
+    else:
+        zf.write(path, arc)
+
+
 COOKBOOK_READ_SCOPES = {"cookbook:read", "cookbook:launch"}
 COOKBOOK_LAUNCH_SCOPES = {"cookbook:launch"}
 TODO_READ_SCOPES = {"todos:read", "todos:write"}
