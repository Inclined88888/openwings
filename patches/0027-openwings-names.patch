+            conn.execute(
+                "UPDATE notification_logs SET task_name = 'OpenWings' WHERE task_name = ?",
+                ("Ody" + "sseus",),
+            )
+            conn.commit()
+    except Exception as e:
+        logging.getLogger(__name__).warning(f"notification sender migration failed: {e}")
