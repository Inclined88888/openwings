+def _wings_is_trusted_builtin(server_id: str, command: str, args) -> bool:
+    """True only for upstream's bundled Python MCP servers (Wings)."""
+    try:
+        import sys as _sys
+        from src.builtin_mcp import _BUILTIN_SERVERS
+        script = (_BUILTIN_SERVERS.get(server_id) or ("",))[0]
+        return bool(
+            script
+            and command == _sys.executable
+            and args
+            and str(args[0]).replace("\\", "/").endswith(script)
+        )
+    except Exception:
+        return False
+
