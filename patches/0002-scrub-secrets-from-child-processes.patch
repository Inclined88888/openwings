diff --git a/src/mcp_manager.py b/src/mcp_manager.py
index 5311200..3722333 100644
--- a/src/mcp_manager.py
+++ b/src/mcp_manager.py
@@ -144,6 +144,22 @@ def mcp_tool_is_readonly(tool: Dict) -> bool:
     return name.startswith(_MCP_READONLY_VERBS)
 
 
+def _wings_is_trusted_builtin(server_id: str, command: str, args) -> bool:
+    """True only for upstream's bundled Python MCP servers (Wings)."""
+    try:
+        import sys as _sys
+        from src.builtin_mcp import _BUILTIN_SERVERS
+        script = (_BUILTIN_SERVERS.get(server_id) or ("",))[0]
+        return bool(
+            script
+            and command == _sys.executable
+            and args
+            and str(args[0]).replace("\\", "/").endswith(script)
+        )
+    except Exception:
+        return False
+
+
 class McpManager:
     """Manages MCP server connections and tool routing."""
 
@@ -214,10 +230,31 @@ class McpManager:
             from mcp.client.stdio import stdio_client
             from contextlib import AsyncExitStack
 
+            # Wings: only upstream's own Python MCP servers inherit the full
+            # environment (they need ODYSSEUS_APP_KEY to read encrypted mail
+            # credentials). User-added and npx servers get it without
+            # deployment secrets; their own configured env still applies.
+            if env:
+                if _wings_is_trusted_builtin(server_id, command, args):
+                    # The launcher keeps the key out of os.environ; hand it
+                    # to upstream's own servers explicitly.
+                    from wings.keyholder import with_key
+                    base_env = with_key(dict(os.environ))
+                else:
+                    from wings.envscrub import scrubbed_environ
+                    base_env = scrubbed_environ()
+                merged_env = {**base_env, **env}
+            elif os.environ.get("WINGS_KEY_FROM_ENV"):
+                # Same minimal environment the MCP SDK would use, plus the
+                # marker that stops a key-less child from minting a key file.
+                from mcp.client.stdio import get_default_environment
+                merged_env = {**get_default_environment(), "WINGS_KEY_FROM_ENV": os.environ["WINGS_KEY_FROM_ENV"]}
+            else:
+                merged_env = None
             server_params = StdioServerParameters(
                 command=command,
                 args=args,
-                env={**os.environ, **env} if env else None,
+                env=merged_env,
             )
 
             stack = AsyncExitStack()
